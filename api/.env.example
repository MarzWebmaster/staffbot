# StaffBot API Environment Variables
# Copy to .env and fill in real values
# WARNING: .env is gitignored — NEVER commit real values

# Database
POSTGRES_PASSWORD=change_me
STAFFBOT_DATABASE_URL=postgresql://staffbot:change_me@db:5432/staffbot_db

# Security (CRITICAL — used to encrypt/decrypt API keys in DB)
STAFFBOT_SECRET_KEY=change_me_64_chars

# Internal auth between services
# STAFFBOT_SERVER_B_API_KEY and GATEWAY_AUTH_KEY must be the same value
# (API -> gateway auth; client containers get a per-client token derived from it)
STAFFBOT_SERVER_B_API_KEY=change_me
GATEWAY_AUTH_KEY=change_me
# X-Internal-Key for Hermes tools. Must equal GATEWAY_API_KEY in the Hermes
# gateway container. Empty = internal impersonation disabled.
STAFFBOT_GATEWAY_API_KEY=change_me

# LLM proxy for customer Hermes containers. Signs per-customer tokens;
# rotating it invalidates every customer token (containers get new ones on restart).
STAFFBOT_LLM_PROXY_SECRET=change_me_64_chars
# Host IP the proxy listens on (host side of the customer network). Default 127.0.0.1.
LLM_PROXY_BIND=127.0.0.1
# Managed Hermes (docs/RUNBOOK_MANAGED_HERMES.md). After setup-host.sh: LLM_PROXY_BIND=172.30.0.1
STAFFBOT_LLM_PROXY_PUBLIC_URL=http://172.30.0.1:8090
STAFFBOT_HERMES_IMAGE=staffbot-hermes:0.22.4-sb1
STAFFBOT_HERMES_RUNTIME=
STAFFBOT_MANAGED_HERMES_ENABLED=false

# LLM Provider API Keys (legacy env fallbacks)
MIMO_API_KEY=sk-change-me
MIMO_BASE_URL=https://api.example.com/v1
HERMES_API_KEY=sk-change-me
# Content moderation layer 2 (platform key; falls back to HERMES_API_KEY)
MODERATION_API_KEY=
MODERATION_URL=

# StaffBot.my API Backend — Environment Variables
# Copy to .env and fill in values

# Database
DB_PASSWORD=staffbot

# Security (change this!)
SECRET_KEY=change-me-to-a-random-64-char-string

# Stripe (optional for MVP testing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare (optional for MVP testing)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Server B (WireGuard VPN: 10.0.0.0/24)
SERVER_B_API_URL=http://10.0.0.2:8080
SERVER_B_API_KEY=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@staffbot.my

# Admin notifications
ADMIN_WHATSAPP=
ADMIN_EMAIL=
ADMIN_PHONE=

# Landing page URL
LANDING_PAGE_URL=https://staffbot.my

# SMS API (optional)
SMS_API_URL=
SMS_API_KEY=

# OpenRouter / LLM
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

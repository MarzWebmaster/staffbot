version: "3.8"

services:
  memory-db:
    image: pgvector/pgvector:pg16
    container_name: staffbot-memory-db
    restart: unless-stopped
    environment:
      POSTGRES_USER: staffbot
      POSTGRES_PASSWORD: staffbot
      POSTGRES_DB: staffbot_memory
    ports:
      - "5434:5432"
    volumes:
      - memory_pgdata:/var/lib/postgresql/data
      - ./init-memory.sql:/docker-entrypoint-initdb.d/init-memory.sql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U staffbot -d staffbot_memory"]
      interval: 10s
      timeout: 5s
      retries: 5
    networks:
      - staffbot-b

  api-gateway:
    build: ./gateway
    container_name: staffbot-gateway
    restart: unless-stopped
    ports:
      - "8080:8080"
    environment:
      DATABASE_URL: postgresql://staffbot:staffbot@memory-db:5432/staffbot_memory
      AUTH_KEY: ${GATEWAY_AUTH_KEY:-staffbot-secret-key}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /root/staffbot/containers:/root/staffbot/containers
    depends_on:
      memory-db:
        condition: service_healthy
    networks:
      - staffbot-b

volumes:
  memory_pgdata:

networks:
  staffbot-b:
    driver: bridge

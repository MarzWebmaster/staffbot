# =============================================================================
# StaffBot.my Server B — Environment Variables (EXAMPLE)
# Copy this to .env and fill in actual values:
#   cp .env.example .env
# Then edit .env with real secrets.
# =============================================================================

# [REQUIRED] Gateway API authentication key
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
GATEWAY_AUTH_KEY=

# [REQUIRED] Memory Database password
# Used by memory-db + api-gateway containers
MEMORY_DB_PASSWORD=
